# ---------------------------------------------------------------------------
# AssetWise Happy Retire — environment variables
# Copy to .env.local for local development. The app builds and runs with all
# of these empty: Google Maps falls back to a static panel and the register
# API answers with a configuration error instead of crashing.
# ---------------------------------------------------------------------------

# "production" treats a missing N8N_WEBHOOK_URL as a real fault.
APP_ENV=development

# n8n lead-capture webhook (server side only, never exposed to the browser).
N8N_WEBHOOK_URL=

# รหัสช่องทางใหม่ของแคมเปญ ใน payload (RefID)
CIS_REF_ID=20260917

# Google Maps JavaScript API key + Map ID (Map ID is required for logo markers).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Set to /happyretire on Vercel so the app is served under
# https://assetwise.co.th/happyretire. Leave empty for local development.
NEXT_PUBLIC_BASE_PATH=

# Public origin used for metadataBase / canonical / OG URLs.
NEXT_PUBLIC_SITE_URL=https://assetwise.co.th
